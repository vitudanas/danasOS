[Unit]
Description=Atualizar o pacote assinado do danasOS
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/danasos/auto-update
ConditionPathExists=/usr/share/danasos/apt/oficial.sources
ConditionKernelCommandLine=!boot=casper
ConditionKernelCommandLine=!boot=live

[Service]
Type=oneshot
ExecStart=/usr/bin/danasos-auto-update executar
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=10min
