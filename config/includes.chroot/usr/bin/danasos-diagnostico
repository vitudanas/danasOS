#!/usr/bin/python3
"""Mostra o estado do hardware e do desktop para validação local."""

import shlex
import shutil
import subprocess

COMANDOS = (
    ("uname", "-r"),
    ("mokutil", "--sb-state"),
    ("modinfo", "-F", "signer", "nvidia"),
    ("prime-select", "query"),
    ("lspci", "-nnk"),
    ("nmcli", "device", "status"),
    ("wpctl", "status"),
    ("xrandr", "--current"),
    ("nvidia-smi", "-L"),
    ("vulkaninfo", "--summary"),
    ("glxinfo", "-B"),
    ("vainfo",),
    ("flatpak", "list", "--app"),
    ("systemd-analyze", "time"),
    ("free", "-h"),
    ("swapon", "--show"),
    ("zramctl",),
    ("lsblk", "-o", "NAME,TYPE,ROTA,DISC-MAX,FSTYPE"),
    ("systemctl", "is-enabled", "fstrim.timer"),
    ("powerprofilesctl", "get"),
    ("gamemoded", "-s"),
    ("mangohud", "--version"),
    ("gamescope", "--version"),
    ("bluetoothctl", "show"),
)

for comando in COMANDOS:
    print(f"\n$ {shlex.join(comando)}", flush=True)
    if shutil.which(comando[0]):
        try:
            processo = subprocess.run(comando, timeout=15)
            if processo.returncode:
                print(f"Código de saída {processo.returncode}")
        except subprocess.TimeoutExpired:
            print("Tempo de consulta excedido.")
    else:
        print("Comando não instalado.")
